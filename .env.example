# ---- Required ----
# Admin token: used to log into the dashboard (POST /api/admin/v1/login)
SETUP_TOKEN=change-me

# ---- Ports and exposure ----
# Three independent surfaces, one process:
#   GEMINI_PORT  Gemini-protocol gateway   (/v1beta/models, ...:generateContent)
#   OPENAI_PORT  OpenAI-protocol gateway   (/v1/models, /v1/chat/completions)
#   ADMIN_PORT   Dashboard + admin API     (web UI under /, /api/admin/v1/*)
#
# Expose ONLY the gateway ports publicly. Keep the dashboard local: bind it to
# loopback (default) and reach it via SSH tunnel or a trusted reverse proxy.
GEMINI_PORT=18770
OPENAI_PORT=18771
ADMIN_PORT=18765
GATEWAY_HOST=0.0.0.0
ADMIN_HOST=127.0.0.1

# ---- Optional ----
DB_PATH=./data/gemini-proxy.db

# 32-byte base64 key. Provider API keys are encrypted at rest with AES-256-GCM.
# Generate: openssl rand -base64 32
# In production (NODE_ENV=production) readiness fails when this is unset.
# APP_ENCRYPTION_KEY=

NODE_ENV=production

# Routing behaviour
KEY_FALLBACK_ATTEMPTS=2        # upstream attempts per request before relaying the last response
KEY_LOOP_DEADLINE_MS=30000     # total time budget for all attempts
REQUEST_TIMEOUT_MS=60000       # per-attempt upstream timeout

# Caching and logs
MODELS_CACHE_TTL_HOURS=24      # model-list cache freshness
LOG_BODY_MAX_BYTES=65536       # max body bytes stored per log entry
MAX_LOG_ENTRIES=1000           # oldest entries pruned automatically

# Limits
MAX_BODY_BYTES=10485760
MAX_RESPONSE_BYTES=52428800

# Trust X-Forwarded-* headers behind a reverse proxy (true/1 only)
TRUST_PROXY=false
