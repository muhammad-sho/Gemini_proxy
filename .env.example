# Optional non-secret runtime settings. Normal setup is done in the dashboard.
PORT=18765
DB_PATH=./data/local-gemini-proxy.db

# Optional tuning:
# REQUEST_TIMEOUT_MS=120000
# Total time budget for trying Gemini keys one-by-one on a failed request
# before giving up (default: same as REQUEST_TIMEOUT_MS)
# KEY_LOOP_DEADLINE_MS=120000
# MAX_BODY_BYTES=10485760
# Hours before the cached model list is refreshed in the background (default 24)
# MODELS_CACHE_TTL_HOURS=24
