# Gemini Proxy configuration
#
# This file is the single source of configuration:
#   - Docker Compose reads it automatically when run next to docker-compose.yml
#   - Running from source reads the same variables from the environment
# Copy to `.env`, then fill in the required values.

# ---- Required ----------------------------------------------------------------
# Admin password for the dashboard login (POST /api/admin/v1/login)
SETUP_TOKEN=change-me

# Encrypts provider API keys at rest (AES-256-GCM). Required in production;
# readiness fails without it. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ---- Surfaces: one process, three listeners ----------------------------------
#   Gemini gateway   /v1beta/models, /v1beta/models/{model}:generateContent
#   OpenAI gateway   /v1/models,     /v1/chat/completions
#   Dashboard/admin  web UI,         /api/admin/v1/*, health checks
#
# Expose only the gateways publicly. Keep the dashboard local and reach it via
# SSH tunnel or an authenticated reverse proxy (see README "Ports and Exposure").
GEMINI_PORT=18770
OPENAI_PORT=18771
ADMIN_PORT=18765
GATEWAY_HOST=0.0.0.0
ADMIN_HOST=127.0.0.1

# ---- Routing -----------------------------------------------------------------
KEY_FALLBACK_ATTEMPTS=2        # upstream attempts per request
KEY_LOOP_DEADLINE_MS=30000     # total time budget for all attempts
REQUEST_TIMEOUT_MS=60000       # per-attempt upstream timeout

# ---- Cache and logs ----------------------------------------------------------
MODELS_CACHE_TTL_HOURS=24      # model-list cache freshness
LOG_LEVEL=info                 # fatal | error | warn | info | debug | trace
LOG_BODY_MAX_BYTES=65536       # max body bytes stored per request-log entry
MAX_LOG_ENTRIES=1000           # request-log retention (oldest pruned)

# ---- Limits ------------------------------------------------------------------
MAX_BODY_BYTES=10485760        # max client request body (10 MB)
MAX_RESPONSE_BYTES=52428800    # max stored upstream response (50 MB)

# ---- Storage and misc --------------------------------------------------------
DB_PATH=./data/gemini-proxy.db
TRUST_PROXY=false              # true only behind a reverse proxy
# NODE_ENV=production          # compose pins this to production
