# Gemini Proxy — deployment configuration
#
# Everything else is configured in the dashboard (Settings tab) or uses
# sensible built-in defaults. On first open the dashboard asks you to create
# an admin password; no secrets belong in this file.
#
# All app data lives in ./data next to this file — back that folder up.

# ---- Ports -----------------------------------------------------------------
GEMINI_PORT=18770   # Gemini-protocol gateway  (/v1beta/*)
OPENAI_PORT=18771   # OpenAI-protocol gateway  (/v1/models, /v1/chat/completions)
ADMIN_PORT=18765    # Dashboard + admin API    (web UI, /api/admin/v1/*, health)

# ---- Exposure ---------------------------------------------------------------
# Bind addresses. Keep the dashboard on loopback and reach it via SSH tunnel
# or an authenticated reverse proxy (see README "Ports and Exposure").
GATEWAY_HOST=0.0.0.0
ADMIN_HOST=127.0.0.1

# ---- Misc -------------------------------------------------------------------
LOG_LEVEL=info      # fatal | error | warn | info | debug | trace
TRUST_PROXY=false   # true only behind a reverse proxy
# NODE_ENV=production  # compose pins this to production
